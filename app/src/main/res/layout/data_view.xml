<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtGPSAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:label="@string/data_gps_accuracy_label"
        app:layout_constraintEnd_toStartOf="@id/txtCog"
        app:layout_constraintStart_toEndOf="@id/txtMagneticDeviation"
        app:layout_constraintTop_toTopOf="@+id/txtMagneticDeviation"
        app:text="@string/txt_na"
        app:valueWidth="72dp"
        tools:text="00.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:label="@string/data_time_utc_label"
        app:text="@string/txt_na"
        app:valueWidth="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtGPSFix"
        app:layout_constraintTop_toTopOf="@+id/txtGPSFix"
        tools:text="0000-00-00T00:00:00Z" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtAtmo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:label="@string/data_atmo_pressure_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/txt_na"
        app:valueWidth="88dp"
        tools:text="0000.0" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtHum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:label="@string/data_humidity_label"
        app:text="@string/txt_na"
        app:valueWidth="72dp"
        app:layout_constraintEnd_toStartOf="@+id/txtRPM"
        app:layout_constraintStart_toEndOf="@+id/txtAtmo"
        app:layout_constraintTop_toTopOf="@+id/txtAtmo"
        tools:text="00.0" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_temperature_label"
        app:text="@string/txt_na"
        app:valueWidth="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAtmo"
        tools:text="00.0" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtSeaTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:label="@string/data_sea_temp_label"
        app:text="@string/txt_na"
        app:valueWidth="64dp"
        app:layout_constraintEnd_toEndOf="@+id/txtHum"
        app:layout_constraintTop_toTopOf="@+id/txtTemp"
        tools:text="00.0" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtHeap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:label="@string/data_heap_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider3"
        app:text="@string/txt_na"
        app:valueWidth="64dp"
        tools:text="000" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtRPM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:label="@string/data_rpm_label"
        app:text="@string/txt_na"
        app:valueWidth="104dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtHum"
        tools:text="0000" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtEngineH"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:label="@string/data_engine_h_label"
        app:text="@string/txt_na"
        app:valueWidth="128dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtSeaTemp"
        tools:text="00000:00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtCan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:label="@string/data_n2k_msg_label"
        app:text="@string/txt_na"
        app:valueWidth="96dp"
        app:layout_constraintEnd_toStartOf="@+id/txtCanSrc"
        app:layout_constraintStart_toEndOf="@+id/txtHeap"
        app:layout_constraintTop_toTopOf="@+id/txtHeap"
        tools:text="000/000" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtCanSrc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:label="@string/data_n2k_label"
        app:text="@string/txt_na"
        app:valueWidth="88dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtHeap"
        tools:text="000/Ok " />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtLat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:label="@string/data_latitude_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider4"
        app:text="@string/txt_na"
        app:valueWidth="160dp"
        tools:text="000,000000" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtLon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_longitude_label"
        app:text="@string/txt_na"
        app:valueWidth="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtLat"
        tools:text="000,000000" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtMagneticDeviation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_magnetic_deviation_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtLon"
        app:text="@string/txt_na"
        app:valueWidth="72dp"
        tools:text="00.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtSog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:label="@string/data_sog_label"
        app:text="@string/txt_na"
        app:valueWidth="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtLat"
        tools:text="00.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtStw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_stw_label"
        app:text="@string/txt_na"
        app:valueWidth="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSog"
        tools:text="00.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtCog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_cog_label"
        app:text="@string/txt_na"
        app:valueWidth="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtStw"
        tools:text="000.0" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtGPSFix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:label="@string/data_gps_fix_label"
        app:text="@string/NO_VALUE_STRING"
        app:valueWidth="32dp"
        app:monospace="false"
        app:alignStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtMagneticDeviation"
        tools:text="XX" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtVoltage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:label="@string/data_voltage_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:monospace="false"
        app:text="@string/NO_VALUE_STRING"
        app:valueWidth="72dp"
        tools:text="00.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        app:label="@string/data_current_label"
        app:text="@string/NO_VALUE_STRING"
        app:valueWidth="72dp"
        app:monospace="false"
        app:layout_constraintEnd_toStartOf="@+id/txtSOC"
        app:layout_constraintStart_toEndOf="@+id/txtVoltage"
        app:layout_constraintTop_toTopOf="@+id/txtVoltage"
        tools:text="000.00" />

    <com.aboni.n2kRouter.LabeledValueView
        android:id="@+id/txtSOC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:label="@string/data_soc_label"
        app:text="@string/NO_VALUE_STRING"
        app:valueWidth="72dp"
        app:monospace="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtCurrent"
        tools:text="000.00" />

    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSeaTemp" />

    <View
        android:id="@+id/divider3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtVoltage" />

    <View
        android:id="@+id/divider4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtHeap" />

    <View
        android:id="@+id/divider5"
        android:layout_width="1dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toTopOf="@+id/txtCurrent"
        app:layout_constraintStart_toEndOf="@+id/txtSeaTemp"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
